// while loop
```

```{javascript}
let i = 0;
while(i < 10){
    if(i === 3){
        i++;
      continue;  
    } 
    if(i === 8) {
        break;
    }
    console.log(i);
    i+=1;
}
```
```+default
let i = 0;
while(i < 10){
    if(i == 3) continue;
    if(i == 8) break;
    console.log(i);
    i+=1;
}
```

```{javascript}
// for loops
const students = ["Alice","Bob","Charlie","Dana"];

for(let i = students.length - 1; i >= 0; i--){
    console.log(students[i]);
}
```
```+default
// for loops
const students = ["Alice","Bob","Charlie","Dana"];

for(let i = students.length - 1; i >= 0; i++){
    console.log(students[i]);
}
```

```{javascript}
// for of loops
const students = ["Alice","Bob","Charlie","Dana"];


for(const student of students){
    console.log(student);
}
```
