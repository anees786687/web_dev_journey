```{javascript}
// while loop
let idx = 0;
const students = ["Alice","Bob","Charlie","Dana"];
const score = [98,95,95,100];

while(idx < students.length){
    console.log(`Student ${students[idx]} Score: ${score[idx]}`);
    idx += 1;
}
```
